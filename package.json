  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/barlow-condensed": "5.1.0",
    "@fontsource/inter": "5.1.0",
    "idb-keyval": "6.2.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.171.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.171.0",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
