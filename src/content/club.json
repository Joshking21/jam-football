{
  "lines": [
    {
      "id": "owner_welcome_01",
      "speaker": "owner",
      "set": "welcome",
      "mood": "neutral",
      "text": "Sit down. I don't do speeches.",
      "voText": "Sit down. I don't do speeches.",
      "voiced": true
    },
    {
      "id": "owner_offer_close_01",
      "speaker": "owner",
      "set": "offer_close",
      "mood": "neutral",
      "text": "Those are the terms. Yes or no?",
      "voText": "Those are the terms. Yes or no?",
      "voiced": true
    },
    {
      "id": "owner_review_happy_01",
      "speaker": "owner",
      "set": "review_happy",
      "mood": "happy",
      "text": "Good. Keep it boring.",
      "voText": "Good. Keep it boring.",
      "voiced": true
    },
    {
      "id": "owner_review_happy_02",
      "speaker": "owner",
      "set": "review_happy",
      "mood": "happy",
      "text": "The town's talking again. I like that.",
      "voText": "The town's talking again. I like that.",
      "voiced": true
    },
    {
      "id": "owner_review_neutral_01",
      "speaker": "owner",
      "set": "review_neutral",
      "mood": "neutral",
      "text": "Fine isn't the same as good.",
      "voText": "Fine isn't the same as good.",
      "voiced": true
    },
    {
      "id": "owner_review_neutral_02",
      "speaker": "owner",
      "set": "review_neutral",
      "mood": "neutral",
      "text": "We're watching. That's all.",
      "voText": "We're watching. That's all.",
      "voiced": true
    },
    {
      "id": "owner_review_worried_01",
      "speaker": "owner",
      "set": "review_worried",
      "mood": "worried",
      "text": "I don't like where this is going.",
      "voText": "I don't like where this is going.",
      "voiced": true
    },
    {
      "id": "owner_review_worried_02",
      "speaker": "owner",
      "set": "review_worried",
      "mood": "worried",
      "text": "Fix it. Soon.",
      "voText": "Fix it. Soon.",
      "voiced": true
    },
    {
      "id": "owner_budget_granted_01",
      "speaker": "owner",
      "set": "budget_granted",
      "mood": "happy",
      "text": "You've earned it. Don't waste it.",
      "voText": "You've earned it. Don't waste it.",
      "voiced": true
    },
    {
      "id": "owner_budget_refused_01",
      "speaker": "owner",
      "set": "budget_refused",
      "mood": "neutral",
      "text": "Win something first.",
      "voText": "Win something first.",
      "voiced": true
    },
    {
      "id": "owner_sacking_01",
      "speaker": "owner",
      "set": "sacking",
      "mood": "angry",
      "text": "I'm sorry. It's over.",
      "voText": "I'm sorry. It's over.",
      "voiced": true
    },
    {
      "id": "owner_sacking_02",
      "speaker": "owner",
      "set": "sacking",
      "mood": "angry",
      "text": "We're making a change. Today.",
      "voText": "We're making a change. Today.",
      "voiced": true
    },
    {
      "id": "owner_verdict_great_01",
      "speaker": "owner",
      "set": "verdict_great",
      "mood": "happy",
      "text": "You gave this town a season. Thank you.",
      "voText": "You gave this town a season. Thank you.",
      "voiced": true
    },
    {
      "id": "owner_verdict_ok_01",
      "speaker": "owner",
      "set": "verdict_ok",
      "mood": "neutral",
      "text": "A start. Next year, more.",
      "voText": "A start. Next year, more.",
      "voiced": true
    },
    {
      "id": "owner_verdict_poor_01",
      "speaker": "owner",
      "set": "verdict_poor",
      "mood": "worried",
      "text": "Not good enough. You know that.",
      "voText": "Not good enough. You know that.",
      "voiced": true
    },
    {
      "id": "coach_walk_in_01",
      "speaker": "coach",
      "set": "walk_in",
      "mood": "neutral",
      "text": "Right. Listen in.",
      "voText": "Right. Listen in.",
      "voiced": true
    },
    {
      "id": "coach_walk_in_02",
      "speaker": "coach",
      "set": "walk_in",
      "mood": "neutral",
      "text": "Eyes on me.",
      "voText": "Eyes on me.",
      "voiced": true
    },
    {
      "id": "coach_walk_in_03",
      "speaker": "coach",
      "set": "walk_in",
      "mood": "neutral",
      "text": "Sit down, lads.",
      "voText": "Sit down, lads.",
      "voiced": true
    },
    {
      "id": "coach_briefing_mentality_01",
      "speaker": "coach",
      "set": "briefing_mentality",
      "mood": "neutral",
      "text": "We go at them. From the first whistle.",
      "voText": "We go at them. From the first whistle.",
      "voiced": true
    },
    {
      "id": "coach_briefing_mentality_02",
      "speaker": "coach",
      "set": "briefing_mentality",
      "mood": "neutral",
      "text": "Patient today. Let them come.",
      "voText": "Patient today. Let them come.",
      "voiced": true
    },
    {
      "id": "coach_briefing_press_01",
      "speaker": "coach",
      "set": "briefing_press",
      "mood": "neutral",
      "text": "Press high. They hate the ball.",
      "voText": "Press high. They hate the ball.",
      "voiced": true
    },
    {
      "id": "coach_briefing_press_02",
      "speaker": "coach",
      "set": "briefing_press",
      "mood": "neutral",
      "text": "Sit in. Stay compact. Pick them off.",
      "voText": "Sit in. Stay compact. Pick them off.",
      "voiced": true
    },
    {
      "id": "coach_briefing_key_battle_01",
      "speaker": "coach",
      "set": "briefing_key_battle",
      "mood": "neutral",
      "text": "Their winger's quick. Stay on your feet, {player}.",
      "voText": "Their winger's quick. Stay on your feet.",
      "voiced": true,
      "nameSlot": "end"
    },
    {
      "id": "coach_briefing_key_battle_02",
      "speaker": "coach",
      "set": "briefing_key_battle",
      "mood": "neutral",
      "text": "That's the game. Win your battle, {player}.",
      "voText": "That's the game. Win your battle.",
      "voiced": true,
      "nameSlot": "end"
    },
    {
      "id": "coach_briefing_set_pieces_01",
      "speaker": "coach",
      "set": "briefing_set_pieces",
      "mood": "neutral",
      "text": "Corners: big men far post. Like we practised.",
      "voText": "Corners: big men far post. Like we practised.",
      "voiced": true
    },
    {
      "id": "coach_briefing_set_pieces_02",
      "speaker": "coach",
      "set": "briefing_set_pieces",
      "mood": "neutral",
      "text": "Their corners are dangerous. Pick up a man.",
      "voText": "Their corners are dangerous. Pick up a man.",
      "voiced": true
    },
    {
      "id": "coach_briefing_width_01",
      "speaker": "coach",
      "set": "briefing_width",
      "mood": "neutral",
      "text": "Stay wide. Stretch them.",
      "voText": "Stay wide. Stretch them.",
      "voiced": true
    },
    {
      "id": "coach_briefing_width_02",
      "speaker": "coach",
      "set": "briefing_width",
      "mood": "neutral",
      "text": "Narrow. Make them go round us.",
      "voText": "Narrow. Make them go round us.",
      "voiced": true
    },
    {
      "id": "coach_shout_pushForward_01",
      "speaker": "coach",
      "set": "shout_pushForward",
      "mood": "neutral",
      "text": "Up! Get up the pitch!",
      "voText": "Up! Get up the pitch!",
      "voiced": true
    },
    {
      "id": "coach_shout_pushForward_02",
      "speaker": "coach",
      "set": "shout_pushForward",
      "mood": "neutral",
      "text": "Go on, push!",
      "voText": "Go on, push!",
      "voiced": true
    },
