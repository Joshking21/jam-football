      "id": "coach_shout_keepTight_01",
      "speaker": "coach",
      "set": "shout_keepTight",
      "mood": "neutral",
      "text": "Tight! Hold your shape!",
      "voText": "Tight! Hold your shape!",
      "voiced": true
